{
  "info": {
    "name": "Retail Analytics - Safe REST Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Demo only. Run Safe smoke folder first. Existing-case reads need an existing case. State-changing draft creation requires prior owner approval and explicit flags; skipped by default. No approval/write SQL/publication tools."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!/^http:\\/\\/127\\.0\\.0\\.1:\\d+$/.test(pm.variables.get(\"base_url\") || \"\")) { pm.execution.skipRequest(); throw new Error(\"Set loopback base_url\"); }"
        ]
      }
    }
  ],
