  "components": {
    "schemas": {
      "CalculationRequest": {
        "properties": {
          "source_file_sha256": {
            "type": "string",
            "const": "BCBE73B35F5B7BABF197FB0CB983A11F5D9FF929078D4AA53D171B1F2DF2E980",
            "title": "Source File Sha256"
          },
          "source_time_interpretation": {
            "type": "string",
            "const": "Europe/London-assumed",
            "title": "Source Time Interpretation"
          },
          "period_start_inclusive": {
            "type": "string",
            "format": "date-time",
            "title": "Period Start Inclusive"
          },
          "period_end_exclusive": {
            "type": "string",
            "format": "date-time",
            "title": "Period End Exclusive"
          },
          "source_as_of_exclusive": {
            "type": "string",
            "format": "date-time",
            "title": "Source As Of Exclusive"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_file_sha256",
          "source_time_interpretation",
          "period_start_inclusive",
          "period_end_exclusive",
          "source_as_of_exclusive"
        ],
        "title": "CalculationRequest",
        "description": "RFC3339 offsets required; start < end <= cutoff; maximum31 days; fixed source hash/time assumption; historical years2009-2011; ambiguous/nonexistent/DST-crossing windows rejected. Unknown fields rejected.",
        "examples": [
          {
            "source_file_sha256": "BCBE73B35F5B7BABF197FB0CB983A11F5D9FF929078D4AA53D171B1F2DF2E980",
            "source_time_interpretation": "Europe/London-assumed",
            "period_start_inclusive": "2011-01-28T09:00:00Z",
            "period_end_exclusive": "2011-01-28T10:00:00Z",
            "source_as_of_exclusive": "2011-01-28T10:00:00Z"
          }
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "detail"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ReportPeriod": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string"
          },
          "kpis": {
            "type": "object",
            "properties": {
              "sale_rows": {
                "type": "number"
              },
              "sales_value_gbp": {
                "type": "number"
              },
              "net_recorded_sales_gbp": {
                "type": "number"
              },
              "cancellation_rows": {
                "type": "number"
              },
              "cancellation_magnitude_gbp": {
                "type": "number"
              }
            },
            "required": [
              "sale_rows",
              "sales_value_gbp",
              "net_recorded_sales_gbp",
              "cancellation_rows",
              "cancellation_magnitude_gbp"
            ]
          },
          "quality": {
            "type": "object",
            "properties": {
              "finding_rows": {
                "type": "integer",
                "minimum": 0
              },
              "flagged_source_rows": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "finding_rows",
              "flagged_source_rows"
            ]
          }
        },
        "required": [
          "schema_version",
          "kpis",
          "quality"
        ]
      },
      "ComparisonReport": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "enum": [
              "deterministic-comparison-report-v1"
            ]
          },
          "current_period": {
            "$ref": "#/components/schemas/ReportPeriod"
          },
          "prior_period": {
            "$ref": "#/components/schemas/ReportPeriod"
          },
          "changes": {
            "type": "object"
          }
        },
        "required": [
          "schema_version",
          "current_period",
          "prior_period",
          "changes"
        ],
        "description": "Minimum documented response shape; SQL preserves NUMERIC as JSON numbers. Additional report/provenance fields are retained. Examples are synthetic, not execution evidence."
      },
      "CaseMetadata": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string"
          },
          "revision": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "case_id",
          "state",
          "revision"
        ]
      },
      "OpenApiDocument": {
        "type": "object",
        "properties": {
          "openapi": {
            "type": "string"
          },
          "info": {
            "type": "object"
          },
          "paths": {
            "type": "object"
          }
        },
        "required": [
          "openapi",
          "info",
          "paths"
        ]
      }
    },
    "securitySchemes": {
      "CalculationToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Fresh demo token, supplied locally; never export filled credentials."
      }
    }
