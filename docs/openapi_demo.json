            "description": "Stored/in progress; repeat the SAME key/payload to resume. Location and Retry-After supplied.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseMetadata"
                }
