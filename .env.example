# Planning template only. The runtime/bootstrap has not been implemented.
# Generate real secrets locally. Never reuse blank/example values in a deployment.
PROJECT_NAME=retail-analytics-automation
APP_ENV=local
APP_BIND_ADDRESS=127.0.0.1
N8N_PORT=5678
APP_PORT=8000
GENERIC_TIMEZONE=UTC
# Source timezone is an interpretation assumption; preserve raw source times.
SOURCE_TIMEZONE=Europe/London
SOURCE_DATASET_ID=502
# Exact pinned versions are selected during G0; do not use latest in releases.
N8N_VERSION=
N8N_RUNNERS_VERSION=
POSTGRES_VERSION=
OLLAMA_VERSION=
N8N_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
APP_SIGNING_SECRET=
WEBHOOK_SIGNING_SECRET=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
OLLAMA_BASE_URL=http://ollama:11434
LOCAL_MODEL=
ENABLE_AI=true
ENABLE_EXTERNAL_WRITES=false
APPROVAL_TTL_SECONDS=86400
MAX_REQUEST_ATTEMPTS=3
MODEL_MAX_REQUESTS_PER_CASE=2
# Optional connected-release settings; configure only in your own demo targets.
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REVIEWER_USER_ID=
