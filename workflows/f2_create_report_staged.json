      "name": "F2 signed creation",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        240
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "f2-create-report-v1",
        "authentication": "none",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "df3a4c8d-e98b-4b7a-b184-143e9bb38b7e"
    },
    {
      "id": "f2-envelope",
      "name": "Check F2 envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        240
      ],
      "parameters": {
        "jsCode": "if ($execution.mode !== 'production') throw new Error('Use the production F2 webhook'); const w=$input.first().json; if (!w.body || !w.query || Object.keys(w.query).length || w.params && Object.keys(w.params).length) throw new Error('Invalid creation envelope'); return [{json:{envelope:w.body,execution_id:String($execution.id)}}];"
      }
    },
    {
      "id": "f2-admission",
      "name": "Verify and atomically admit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "http://approval:8000/f2-internal/admit",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "f2-assert",
      "name": "Require committed admission",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        240
      ],
      "parameters": {
        "jsCode": "const a=$input.first().json; const e=$('Check F2 envelope').first().json; if(a.admitted!==true || a.operation_id!==e.envelope.operation_id || a.execution_id!==String($execution.id)) throw new Error('Creation admission denied'); return [{json:{operation_id:a.operation_id}}];"
      }
    }
  ],
